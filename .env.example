# Configuração do Jornada360.
#
# Copie para `.env` e ajuste. O `.env` NÃO deve ser versionado — só este exemplo.
# Nenhuma credencial real pertence a este arquivo.

# ---------------------------------------------------------------- backend (server/)

# Porta da API.
JORNADA_PORT=3333

# Caminho do banco SQLite. Use caminhos diferentes por ambiente para que um nunca escreva
# sobre o outro. Os testes definem o seu próprio e não usam este valor.
#   desenvolvimento: ./data/jornada360.db
#   produção:        um volume persistente fora da pasta do código
JORNADA_DB_PATH=./data/jornada360.db

# Origens autorizadas a chamar a API, separadas por vírgula.
# NUNCA use "*": com `credentials: true` (a sessão viaja em cookie), uma origem errada nesta lista
# significa entregar o cookie da vítima ao site errado.
JORNADA_CORS_ORIGENS=http://localhost:5173

# Liga o atributo `Secure` no cookie de sessão. OBRIGATÓRIO em produção; impossível em
# http://localhost — um cookie `Secure` simplesmente não é gravado sem HTTPS, e o login pareceria
# quebrado. `NODE_ENV=production` liga sozinho.
# JORNADA_COOKIE_SEGURO=1

# Atrás de proxy reverso, `req.ip` é o IP do proxy — o que faz o limite de tentativas tratar todo
# mundo como a mesma pessoa. Só ligue se houver proxy de verdade: confiar em X-Forwarded-For sem
# ele permite forjar o IP.
# JORNADA_TRUST_PROXY=1

# ---------------------------------------------------------------- frontend (Vite)

# URL da API. VAZIO por padrão, e isso é intencional: as requisições saem RELATIVAS, o navegador
# enxerga página e API na mesma origem, e o cookie de sessão funciona como first-party.
# Em desenvolvimento quem garante isso é o proxy do Vite (ver vite.config.ts).
#
# Definir esta variável aponta o frontend para outro domínio — o que DESLIGA o cookie de sessão
# (ele exigiria SameSite=None; Secure). Só use sabendo disso. Ver AUTH.md.
# VITE_API_URL=

# Alvo do proxy do Vite em desenvolvimento, se a API estiver em outra porta/máquina.
# JORNADA_API_ALVO=http://localhost:3333

# ---------------------------------------------------------------- ainda não usados
#
# Registrados aqui para deixar claro o que uma operação real vai exigir. Nenhum tem
# implementação hoje — ver INTEGRATIONS.md e SAAS_ARCHITECTURE.md.
#
# COBLI_API_TOKEN=            # integração de rastreamento (pendente de credencial)
# PONTO_API_URL=              # sistema de ponto (pendente de definição do fornecedor)
# SMTP_URL=                   # envio de e-mail: convite e recuperação de senha
