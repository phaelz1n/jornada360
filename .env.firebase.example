# Variáveis de ambiente Firebase para o Jornada360
#
# Copie este arquivo para `.env` e preencha com os valores do seu projeto Firebase.
# Encontre estas informações em: Firebase Console → Configurações do Projeto → Seus apps → Web
#
# IMPORTANTE: todas as variáveis VITE_* ficam visíveis no bundle do navegador.
# NUNCA coloque chaves privadas (Firebase Admin SDK) aqui — elas ficam em outro lugar.

# ---------------------------------------------------------------- Firebase Web SDK

# Chave pública da API (não é secreta — o Firebase usa CORS + Security Rules para proteger)
VITE_FIREBASE_API_KEY=AIzaSy...

# Domínio de autenticação do seu projeto
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com

# ID do projeto Firebase (ex: jornada360-producao)
VITE_FIREBASE_PROJECT_ID=seu-projeto-id

# Bucket do Storage (se usar Firebase Storage no futuro)
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app

# ID do remetente de mensagens (para Firebase Cloud Messaging, se usar)
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789

# ID do aplicativo web
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ---------------------------------------------------------------- Desenvolvimento

# Define como true para usar emuladores locais (firebase emulators:start)
# NUNCA defina isso como true em produção
VITE_USE_FIREBASE_EMULATOR=false
