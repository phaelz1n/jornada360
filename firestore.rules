rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    match /motoristas/{id} { allow read, write: if true; }
    match /escalas/{id} { allow read, write: if true; }
    match /padroes_horario/{id} { allow read, write: if true; }
    match /dias_processados/{id} { allow read, write: if true; }
    match /checklist/{id} { allow read, write: if true; }
    match /memoria_escala/{id} { allow read, write: if true; }
    match /importacoes/{id} { allow read, write: if true; }
    match /workspaces/{workspaceId} { allow read, write: if isAuthenticated(); }
    match /snapshots_dias/{docId} { allow read, write: if isAuthenticated(); }
    match /pendencias/{pendenciaId} { allow read, write: if isAuthenticated(); }
    match /historico_auditoria/{entryId} { allow read, write: if isAuthenticated(); }
  }
}
