rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'operacional4@transpinho.com';
    }

    function hasFeriasAccess() {
      return isAdmin()
        || (isAuthenticated() && request.auth.token.email in ['rh@transpinho.com', 'tielle@transpinho.com'])
        || (isAuthenticated()
          && exists(/databases/$(database)/documents/permissoes_sistemas/$(request.auth.token.email))
          && get(/databases/$(database)/documents/permissoes_sistemas/$(request.auth.token.email)).data.ferias == true);
    }

    function isFeriasManager() {
      return hasFeriasAccess();
    }

    function hasJornadaAccess() {
      return isAdmin()
        || (isAuthenticated()
          && exists(/databases/$(database)/documents/permissoes_sistemas/$(request.auth.token.email))
          && get(/databases/$(database)/documents/permissoes_sistemas/$(request.auth.token.email)).data.jornada == true);
    }

    function validAuditEntry() {
      return request.resource.data.keys().hasOnly([
          'action', 'dateKey', 'actorEmail', 'createdAt', 'updatedAt',
          'sources', 'itemCount', 'validatedCount', 'detailCount', 'occurrenceType', 'minutes', 'source', 'driverCount', 'dayCount'
        ])
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 64
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.size() <= 32
        && request.resource.data.actorEmail is string
        && request.resource.data.actorEmail.size() <= 160
        && ((request.resource.data.action == 'importacao_processada'
          && request.resource.data.createdAt is string
          && request.resource.data.sources is map)
          || (request.resource.data.action == 'checklist_atualizado'
          && request.resource.data.updatedAt is string
          && request.resource.data.itemCount is int
          && request.resource.data.validatedCount is int
          && request.resource.data.detailCount is int)
          || (request.resource.data.action == 'ocorrencia_criada'
          && request.resource.data.createdAt is string
          && request.resource.data.occurrenceType is string
          && request.resource.data.occurrenceType.size() <= 32
          && request.resource.data.minutes is int
          && request.resource.data.minutes >= 0
          && request.resource.data.minutes <= 1440)
          || (request.resource.data.action == 'backup_migrado'
          && request.resource.data.createdAt is string
          && request.resource.data.source is string
          && request.resource.data.source.size() <= 64
          && request.resource.data.driverCount is int
          && request.resource.data.dayCount is int
          && request.resource.data.driverCount >= 0
          && request.resource.data.dayCount >= 0));
    }

    match /motoristas/{id} { allow read, write: if hasJornadaAccess(); }
    match /escalas/{id} { allow read, write: if hasJornadaAccess(); }
    match /padroes_horario/{id} { allow read, write: if hasJornadaAccess(); }
    match /dias_processados/{id} { allow read, write: if hasJornadaAccess(); }
    match /checklist/{id} { allow read, write: if hasJornadaAccess(); }
    match /memoria_escala/{id} { allow read, write: if hasJornadaAccess(); }
    match /importacoes/{id} { allow read, write: if hasJornadaAccess(); }

    match /workspaces/{workspaceId} { allow read, write: if hasJornadaAccess(); }
    match /snapshots_dias/{docId} { allow read, write: if hasJornadaAccess(); }
    match /pendencias/{pendenciaId} { allow read, write: if hasJornadaAccess(); }
    match /historico_auditoria/{entryId} {
      allow read: if isAuthenticated();
      allow create: if (hasJornadaAccess() || hasFeriasAccess()) && validAuditEntry();
      allow update, delete: if false;
    }
    match /ocorrencias/{id} { allow read, write: if hasJornadaAccess(); }
    match /permissoes_sistemas/{email} {
      allow read: if isAuthenticated() && (request.auth.token.email == email || request.auth.token.email == 'operacional4@transpinho.com');
      allow create, update: if isAuthenticated() && request.auth.token.email == 'operacional4@transpinho.com';
      allow delete: if false;
    }
    match /ferias_turnos/{id} { allow read: if hasFeriasAccess(); allow create, update: if isFeriasManager(); allow delete: if false; }
    match /ferias_feristas/{id} { allow read: if hasFeriasAccess(); allow create, update: if isFeriasManager(); allow delete: if false; }
    match /ferias_importacoes/{id} { allow read: if isFeriasManager(); allow create: if isFeriasManager(); allow update, delete: if false; }
    match /ferias_pessoas/{id} { allow read: if isFeriasManager(); allow create, update: if isFeriasManager(); allow delete: if false; }
    match /ferias_pessoa_turnos/{id} { allow read: if isFeriasManager(); allow create, update: if isFeriasManager(); allow delete: if false; }
    match /ferias_sugestoes/{id} { allow read: if isFeriasManager(); allow create, update: if isFeriasManager(); allow delete: if false; }
    match /ferias_programacoes/{id} { allow read: if isFeriasManager(); allow create, update: if isFeriasManager(); allow delete: if false; }
    match /ferias_auditoria/{id} { allow read: if isFeriasManager(); allow create: if isFeriasManager(); allow update, delete: if false; }
  }
}

