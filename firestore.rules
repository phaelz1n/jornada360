rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'operacional4@transpinho.com',
          'rh@transpinho.com',
          'tielle@transpinho.com'
        ];
    }

    function validAuditEntry() {
      return request.resource.data.keys().hasOnly([
          'action', 'dateKey', 'actorEmail', 'createdAt', 'updatedAt',
          'sources', 'itemCount', 'validatedCount', 'detailCount', 'occurrenceType', 'minutes', 'source', 'driverCount', 'dayCount'
        ])
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 64
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.size() <= 32
        && request.resource.data.actorEmail is string
        && request.resource.data.actorEmail.size() <= 160
        && ((request.resource.data.action == 'importacao_processada'
          && request.resource.data.createdAt is string
          && request.resource.data.sources is map)
          || (request.resource.data.action == 'checklist_atualizado'
          && request.resource.data.updatedAt is string
          && request.resource.data.itemCount is int
          && request.resource.data.validatedCount is int
          && request.resource.data.detailCount is int)
          || (request.resource.data.action == 'ocorrencia_criada'
          && request.resource.data.createdAt is string
          && request.resource.data.occurrenceType is string
          && request.resource.data.occurrenceType.size() <= 32
          && request.resource.data.minutes is int
          && request.resource.data.minutes >= 0
          && request.resource.data.minutes <= 1440)
          || (request.resource.data.action == 'backup_migrado'
          && request.resource.data.createdAt is string
          && request.resource.data.source is string
          && request.resource.data.source.size() <= 64
          && request.resource.data.driverCount is int
          && request.resource.data.dayCount is int
          && request.resource.data.driverCount >= 0
          && request.resource.data.dayCount >= 0));
    }

    match /motoristas/{id} { allow read, write: if isAuthenticated(); }
    match /escalas/{id} { allow read, write: if isAuthenticated(); }
    match /padroes_horario/{id} { allow read, write: if isAuthenticated(); }
    match /dias_processados/{id} { allow read, write: if isAuthenticated(); }
    match /checklist/{id} { allow read, write: if isAuthenticated(); }
    match /memoria_escala/{id} { allow read, write: if isAuthenticated(); }
    match /importacoes/{id} { allow read, write: if isAuthenticated(); }

    match /workspaces/{workspaceId} { allow read, write: if isAuthenticated(); }
    match /snapshots_dias/{docId} { allow read, write: if isAuthenticated(); }
    match /pendencias/{pendenciaId} { allow read, write: if isAuthenticated(); }
    match /historico_auditoria/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && validAuditEntry();
      allow update, delete: if false;
    }
    match /ocorrencias/{id} { allow read, write: if isAuthenticated(); }
  }
}

