rules_version = '2';

// Regras de Segurança do Cloud Firestore — Jornada360
//
// Princípios:
// 1. O usuário precisa estar autenticado via Firebase Authentication (request.auth != null).
// 2. Cada usuário acessa seus próprios dados de usuário em /users/{userId} e seus índices em /user_memberships/{userId}.
// 3. Usuários autenticados têm permissão para criar, ler e atualizar empresas e suas subcoleções operacionais
//    (config, time_records, pendings, audit_log, memberships, invites).
// 4. Elimina dependências lentas ou falhas de sub-consultas exists() para documentos recém-criados.

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    // Perfil do usuário
    match /users/{userId} {
      allow read, write: if autenticado() && request.auth.uid == userId;
    }

    // Índice de empresas do usuário (usuário -> tenants)
    match /user_memberships/{userId}/{document=**} {
      allow read, write: if autenticado() && request.auth.uid == userId;
    }

    // Empresas (tenants) e todas as suas subcoleções operacionais
    match /tenants/{tenantId} {
      allow read, write: if autenticado();

      match /{subcollection=**} {
        allow read, write: if autenticado();
      }
    }

    // Convites globais
    match /convites/{codigoId} {
      allow read, write: if autenticado();
    }
  }
}
