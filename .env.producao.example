# ==============================================================================
# Jornada360 — CONFIGURAÇÃO DE PRODUÇÃO
#
# Copie para `.env` NA MÁQUINA DE PRODUÇÃO e preencha. Nunca versione o `.env`.
#
# O servidor RECUSA SUBIR se algo aqui estiver inseguro. Isso é de propósito: a forma mais comum
# de um sistema ir para produção inseguro não é alguém decidir isso — é um valor de
# desenvolvimento sobrando numa variável que ninguém conferiu.
# ==============================================================================

NODE_ENV=production

# ------------------------------------------------------------------ domínio
# O domínio que o cliente vai digitar. Precisa apontar para o IP deste servidor ANTES de subir:
# o Let's Encrypt confirma a posse conectando de volta.
JORNADA_DOMINIO=jornada360.suaempresa.com.br

# Endereço para o Let's Encrypt avisar sobre certificado prestes a vencer.
JORNADA_EMAIL_ADMIN=voce@suaempresa.com.br

# A mesma URL, completa. Usada nos links de e-mail — sem ela, recuperação de senha e convite saem
# com link quebrado.
JORNADA_URL_PUBLICA=https://jornada360.suaempresa.com.br

# Origens autorizadas. Normalmente igual à URL pública.
# NUNCA "*": com a sessão em cookie, uma origem errada aqui entrega o cookie ao site errado.
JORNADA_CORS_ORIGENS=https://jornada360.suaempresa.com.br

# ------------------------------------------------------------------ sessão
# Obrigatório em produção. Sem isto o cookie de sessão trafega sem proteção.
JORNADA_COOKIE_SEGURO=1

# Necessário porque o Caddy fica na frente. Sem isso, o limite de tentativas de senha vê o IP do
# proxy em toda requisição e trata todo mundo como a mesma pessoa.
JORNADA_TRUST_PROXY=1

# ------------------------------------------------------------------ programa piloto
# Em produção o cadastro nasce FECHADO: ninguém cria conta nem empresa sozinho. É assim que se
# controla quais empresas têm acesso durante a venda piloto. Quem entra é quem foi liberado pela
# CLI (`npm run piloto liberar`) ou convidado por um cliente já liberado (tela /convite).
#
# Deixe COMENTADO para manter fechado. Descomente com 1 apenas se um dia o produto passar a
# aceitar autoatendimento — e leia PILOTO.md antes.
# JORNADA_CADASTRO_ABERTO=1

# ------------------------------------------------------------------ dados
# Dentro do container, estes caminhos são volumes — é o que faz os dados sobreviverem a um deploy.
# NÃO aponte para dentro da pasta do código: o próximo deploy apagaria o banco de todos os clientes.
JORNADA_DB_PATH=/dados/jornada360.db
JORNADA_BACKUP_DIR=/backups
JORNADA_BACKUP_INTERVALO_HORAS=6
JORNADA_BACKUP_MANTER_DIAS=14

# ------------------------------------------------------------------ e-mail
# OBRIGATÓRIO. Sem SMTP, recuperação de senha e convites não chegam a ninguém — e o servidor
# recusa subir em vez de deixar isso parecer funcionar.
#
# Provedores que funcionam bem para volume baixo (ver DEPLOY.md para o passo a passo):
#   Resend        smtp://resend:SUA_CHAVE@smtp.resend.com:587
#   Brevo         smtp://SEU_LOGIN:SUA_CHAVE@smtp-relay.brevo.com:587
#   Amazon SES    smtps://USUARIO:SENHA@email-smtp.sa-east-1.amazonaws.com:465
#   Gmail         NÃO recomendado — limites baixos e bloqueio frequente
JORNADA_EMAIL_MODO=smtp
JORNADA_SMTP_URL=smtp://usuario:senha@smtp.seuprovedor.com:587

# O remetente precisa ser de um domínio que você controla e que esteja verificado no provedor.
# Um remetente não verificado cai em spam ou é recusado.
JORNADA_EMAIL_REMETENTE=Jornada360 <nao-responda@suaempresa.com.br>

# ------------------------------------------------------------------ aplicação
JORNADA_PORT=3333
JORNADA_SERVIR_FRONTEND=1
